# Install-script policy (ratified 2026-08-24).
#
# strict-allow-scripts turns the allowScripts policy in package.json from a
# WARNING into a hard error: any dependency that gains an install script and
# is not explicitly reviewed fails `npm ci` instead of silently executing.
# Without this line the policy is advisory and a new transitive install
# script runs unreviewed.
strict-allow-scripts=true

# npm before 11.6 does not understand allowScripts or strict-allow-scripts:
# it ignores both and runs every install script with no error, which is a
# silent false green. engine-strict makes the engines range in package.json
# a hard requirement so an old npm fails loudly instead.
engine-strict=true
