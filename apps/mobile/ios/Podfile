# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AthleteKinetics' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    patch_fmt_consteval_for_apple_clang!(installer)
    make_glog_namespace_headers_textual!(installer)
    raise_pod_deployment_targets!(installer)
  end
end

# A pod target keeps the deployment target its own podspec declares.
# react-native-blob-util 0.24.9 declares iOS 11.0, and its privacy-manifest
# resource bundle is generated with that value. Xcode 26 builds it; Xcode 27
# supports 15.0 and later only and stops the build at that target (issue #38:
# "The iOS Simulator deployment target 'IPHONEOS_DEPLOYMENT_TARGET' is set to
# 11.0, but the range of supported deployment target versions is 15.0 to
# 27.0.x"). The app itself already requires React Native's minimum, so every
# pod target below that minimum is raised to it; none is lowered.
def raise_pod_deployment_targets!(installer)
  minimum = Gem::Version.new(min_ios_version_supported)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_s
      next unless current.match?(/\A\d+(\.\d+)*\z/) && Gem::Version.new(current) < minimum
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
      Pod::UI.puts "#{target.name} (#{config.name}): iOS deployment target #{current} raised to #{min_ios_version_supported}".green
    end
  end
end

# glog 0.3.5 (pinned by React Native 0.81) #includes glog/log_severity.h and
# glog/vlog_is_on.h INSIDE `namespace google` (logging.h and raw_logging.h), so
# those two are textual headers by design. React Native's glog podspec sets
# DEFINES_MODULE, and CocoaPods' generated module map turns every header into
# its own submodule. Swift/C++ interop (NitroModules, used by the Apple Health
# binding) builds that module in C++ mode, and Clang rejects it: "import of
# module 'glog.glog.log_severity' appears within namespace 'google'". The
# generated map is replaced by an explicit one that keeps the three real
# headers modular and marks the two namespace-included headers textual. No
# glog source changes. Fails closed if the map or a header is not found.
def make_glog_namespace_headers_textual!(installer)
  return if installer.pod_targets.none? { |target| target.pod_name == 'glog' }
  root = Pathname.new(installer.sandbox.root)
  headers = root + 'Headers/Public/glog/glog'
  modular = %w[logging.h raw_logging.h stl_logging.h]
  textual = %w[log_severity.h vlog_is_on.h]
  missing = (modular + textual).reject { |name| (headers + name).exist? }
  raise "glog headers not found in #{headers}: #{missing.join(', ')}" unless missing.empty?
  maps = (Dir.glob(root + 'Headers/Public/glog/*.modulemap') + Dir.glob(root + 'Target Support Files/glog/*.modulemap'))
    .map { |path| File.realpath(path) }.uniq
  raise 'glog module map not found; refusing to continue without the textual-header fix' if maps.empty?
  maps.each do |map|
    original = File.read(map)
    next if original.include?('athlete-kinetics: glog textual headers')
    Pod::UI.puts "glog module map #{map} (original):\n#{original}"
    # Absolute paths: the map is reached through a symlink in Headers/Public
    # as well as directly, and relative paths would resolve differently.
    rel = File.realpath(headers.to_s)
    lines = ['// athlete-kinetics: glog textual headers (see Podfile)', 'module glog {']
    modular.each { |name| lines << "  header \"#{rel}/#{name}\"" }
    textual.each { |name| lines << "  textual header \"#{rel}/#{name}\"" }
    lines += ['  export *', '}', '']
    File.chmod(0644, map)
    File.write(map, lines.join("\n"))
    Pod::UI.puts "glog module map #{map}: log_severity.h and vlog_is_on.h are now textual".green
  end
end

# fmt 11.0.2 (pinned by React Native 0.81) enables consteval for Apple clang
# >= 14. The stricter Apple clang in Xcode 26 rejects FMT_STRING call sites in
# fmt's own format-inl.h ("call to consteval function ... is not a constant
# expression", https://github.com/fmtlib/fmt/issues/4740). Upstream's fix is to
# treat every Apple clang like Apple clang < 14 (FMT_USE_CONSTEVAL 0): fmt's
# constexpr fallback is fully functional; only the compile-time format-string
# check is lost. A -D flag cannot do this because base.h redefines the macro.
# Scoped to exactly fmt 11.0.2 and exactly this one line; fails closed if the
# line is not where it is expected. Remove once React Native pins a fixed fmt.
def patch_fmt_consteval_for_apple_clang!(installer)
  gate = '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L'
  patched = '#elif defined(__apple_build_version__)  // athlete-kinetics: fmtlib/fmt#4740'
  fmt = installer.pod_targets.find { |target| target.pod_name == 'fmt' }
  return if fmt.nil?
  version = fmt.root_spec.version.to_s
  unless version == '11.0.2'
    Pod::UI.puts "fmt #{version}: Apple clang consteval patch not applied (written for 11.0.2 only)".yellow
    return
  end
  base_h = File.join(installer.sandbox.pod_dir('fmt'), 'include', 'fmt', 'base.h')
  text = File.read(base_h)
  return if text.include?(patched)
  unless text.scan(gate).length == 1
    raise "fmt 11.0.2 base.h does not contain the expected Apple clang consteval gate exactly once; refusing to patch"
  end
  File.chmod(0644, base_h)
  File.write(base_h, text.sub(gate, patched))
  Pod::UI.puts 'fmt 11.0.2: FMT_USE_CONSTEVAL disabled for Apple clang (fmtlib/fmt#4740)'.green
end
