# Deterministic line endings for a multi-agent, multi-OS repo.
# Source, config, docs: LF in the repository, always.
* text=auto eol=lf

# Windows script formats that require/expect CRLF to execute reliably.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: never touch.
*.png binary
*.jpg binary
*.pdf binary
*.gguf binary
*.onnx binary
*.db binary
*.keystore binary
*.jar binary

# Frozen evidence archives: byte-for-byte preservation, no EOL conversion.
# These artifacts are identified by SHA-256 in docs/research/ and in commit
# messages. Normalising their line endings would silently break every recorded
# hash, so all conversion is disabled here. Do not remove this rule.
docs/research/audits/** -text
